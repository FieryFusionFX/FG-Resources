# =====================================================================
# SECRETS / PER-DEPLOYMENT CONFIG - TEMPLATE
# =====================================================================
# Copy this file to "secrets.cfg" (which is gitignored - never commit the
# real one) and fill in the values for THIS box/deployment.
# =====================================================================

## --- Cfx.re license (from https://keymaster.fivem.net/) ---
sv_licenseKey "PASTE_YOUR_LICENSE_KEY_HERE"

## --- Database connection (from the MariaDB/MySQL instance for this box) ---
set mysql_connection_string "mysql://root@localhost/Qbox_A1B5B5?charset=utf8mb4"

## --- Server branding (change per deployment/rebrand) ---
sv_hostname "Fierygames built with Qbox Project by The Community!"
sets sv_projectName "[Qbox Project] Fierygames"
sets sv_projectDesc "A FiveM core with a load of bloat."
set qbx:discordLink "" # TODO: set your own server's Discord invite link here

## --- Admin identity (tie a real FiveM account to the admin group) ---
add_principal identifier.fivem:4707155 group.admin #FieryFusionFX

## --- Third-party API keys (optional, leave blank if unused) ---
set steam_webApiKey "none"
set SCREENSHOT_BASIC_TOKEN "" # npwd camera - https://projecterror.dev/docs/npwd/start/installation#setting-up-camera-functionality
set NPWD_AUDIO_TOKEN ""       # npwd audio
set inventory:webhook ""      # ox_inventory Discord webhook for image-metadata moderation
